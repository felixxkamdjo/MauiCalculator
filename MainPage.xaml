<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiCalculator.MainPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#000000"
             SizeChanged="OnPageSizeChanged">

    <Grid>
        <!-- main layout -->
        <Grid x:Name="mainGrid"
              Padding="16, 10, 16, 12"
              RowSpacing="10"
              ColumnSpacing="14">

            <!--  -->
            <Grid x:Name="displaySection" RowDefinitions="Auto, *">
                
                <!-- header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0, 2, 0, 4">
                    <HorizontalStackLayout Grid.Column="0" Spacing="24" VerticalOptions="Center">
                        <Label Text="Calculator"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF" />
                        <Label Text="Converter"
                               FontSize="18"
                               TextColor="#71717A"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConverterTabTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Label Grid.Column="1"
                           Text="⋮"
                           FontSize="22"
                           TextColor="#FFFFFF"
                           Padding="10, 0"
                           VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenModalClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- history block -->
                <ScrollView Grid.Row="1"
                            x:Name="scrollHistory"
                            VerticalOptions="End"
                            VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Fill">
                        <VerticalStackLayout x:Name="historyContainer" Spacing="4" />

                        <Label x:Name="lblEquation"
                               Text=""
                               FontSize="18"
                               TextColor="#A1A1AA"
                               HorizontalTextAlignment="End" />

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center">
                                <Label x:Name="lblDisplay"
                                       Text="0"
                                       FontSize="42"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       HorizontalTextAlignment="End" />
                                <Label x:Name="lblCursor"
                                       Text="|"
                                       FontSize="42"
                                       TextColor="#512BD4"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- keypad -->
            <Grid x:Name="keypadGrid"
                  RowSpacing="6"
                  ColumnSpacing="8"
                  VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- row 0 : advanced operations -->
                <Button Text="√" Grid.Row="0" Grid.Column="0" Clicked="OnSqrtClicked"
                        BackgroundColor="#1C1C1E" TextColor="#A1A1AA" CornerRadius="12" FontSize="17" />
                <Button Text="x²" Grid.Row="0" Grid.Column="1" Clicked="OnSquareClicked"
                        BackgroundColor="#1C1C1E" TextColor="#A1A1AA" CornerRadius="12" FontSize="15" />
                <Button Text="1/x" Grid.Row="0" Grid.Column="2" Clicked="OnReciprocalClicked"
                        BackgroundColor="#1C1C1E" TextColor="#A1A1AA" CornerRadius="12" FontSize="14" />
                <Button Text="π" Grid.Row="0" Grid.Column="3" Clicked="OnPiClicked"
                        BackgroundColor="#1C1C1E" TextColor="#A1A1AA" CornerRadius="12" FontSize="15" />

                <!-- row 1 - fonctions -->
                <Button Text="C" Grid.Row="1" Grid.Column="0" Clicked="OnClearClicked"
                        BackgroundColor="#27272A" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" FontAttributes="Bold" />
                <Button Text="⌫" Grid.Row="1" Grid.Column="1" Clicked="OnDeleteClicked"
                        BackgroundColor="#27272A" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" FontAttributes="Bold" />
                <Button Text="%" Grid.Row="1" Grid.Column="2" Clicked="OnPercentageClicked"
                        BackgroundColor="#27272A" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" FontAttributes="Bold" />
                <Button Text="÷" Grid.Row="1" Grid.Column="3" Clicked="OnOperatorClicked"
                        BackgroundColor="#512BD4" TextColor="#FFFFFF" CornerRadius="12" FontSize="22" FontAttributes="Bold" />

                <!-- row 2 -->
                <Button Text="7" Grid.Row="2" Grid.Column="0" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="8" Grid.Row="2" Grid.Column="1" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="9" Grid.Row="2" Grid.Column="2" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="×" Grid.Row="2" Grid.Column="3" Clicked="OnOperatorClicked"
                        BackgroundColor="#512BD4" TextColor="#FFFFFF" CornerRadius="12" FontSize="22" FontAttributes="Bold" />

                <!-- row 3 -->
                <Button Text="4" Grid.Row="3" Grid.Column="0" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="5" Grid.Row="3" Grid.Column="1" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="6" Grid.Row="3" Grid.Column="2" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="-" Grid.Row="3" Grid.Column="3" Clicked="OnOperatorClicked"
                        BackgroundColor="#512BD4" TextColor="#FFFFFF" CornerRadius="12" FontSize="24" FontAttributes="Bold" />

                <!-- row 4 -->
                <Button Text="1" Grid.Row="4" Grid.Column="0" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="2" Grid.Row="4" Grid.Column="1" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="3" Grid.Row="4" Grid.Column="2" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="+" Grid.Row="4" Grid.Column="3" Clicked="OnOperatorClicked"
                        BackgroundColor="#512BD4" TextColor="#FFFFFF" CornerRadius="12" FontSize="22" FontAttributes="Bold" />

                <!-- row 5 -->
                <Button Text="±" Grid.Row="5" Grid.Column="0" Clicked="OnNegateClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="0" Grid.Row="5" Grid.Column="1" Clicked="OnDigitClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="." Grid.Row="5" Grid.Column="2" Clicked="OnDecimalClicked"
                        BackgroundColor="#141416" TextColor="#FAFAFA" CornerRadius="12" FontSize="19" />
                <Button Text="=" Grid.Row="5" Grid.Column="3" Clicked="OnEqualsClicked"
                        BackgroundColor="#6D3EE4" TextColor="#FFFFFF" CornerRadius="12" FontSize="22" FontAttributes="Bold" />
            </Grid>
        </Grid>

        <!-- modal confirmation -->
        <Grid x:Name="modalOverlay"
              IsVisible="False"
              BackgroundColor="#AA000000">
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Stroke="#27272A"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#18181B"
                    Padding="22">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Clear History"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#FAFAFA" />
                    <Label Text="Are you sure you want to delete all calculation logs?"
                           FontSize="15"
                           TextColor="#A1A1AA"
                           LineBreakMode="WordWrap" />
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="End" Margin="0, 8, 0, 0">
                        <Button Text="Cancel"
                                Clicked="OnCloseModalClicked"
                                BackgroundColor="Transparent"
                                TextColor="#A1A1AA"
                                FontSize="15" />
                        <Button Text="Clear"
                                Clicked="OnConfirmClearHistoryClicked"
                                BackgroundColor="#EF4444"
                                TextColor="#FFFFFF"
                                CornerRadius="12"
                                FontSize="15"
                                FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>