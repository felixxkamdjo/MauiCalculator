<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiCalculator.ConverterPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#000000"
             SizeChanged="OnConverterPageSizeChanged">

    <Grid>
        <Grid x:Name="converterGrid"
              Padding="16, 10, 16, 12"
              RowSpacing="10"
              ColumnSpacing="14">

            <!-- left side -->
            <ScrollView x:Name="cardsSection" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">
                    
                    <!-- header -->
                    <Grid Margin="0, 2, 0, 2">
                        <HorizontalStackLayout Spacing="24" VerticalOptions="Center">
                            <Label Text="Calculator"
                                   FontSize="18"
                                   TextColor="#71717A"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCalculatorTabTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="Converter"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- categories selection -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="btnCatLength" Text="Length" Clicked="OnCategorySelected"
                                    BackgroundColor="#512BD4" TextColor="#FFFFFF" CornerRadius="18" HeightRequest="36" Padding="14, 0" />
                            <Button x:Name="btnCatMass" Text="Mass" Clicked="OnCategorySelected"
                                    BackgroundColor="#1C1C1E" TextColor="#A1A1AA" CornerRadius="18" HeightRequest="36" Padding="14, 0" />
                            <Button x:Name="btnCatTemp" Text="Temperature" Clicked="OnCategorySelected"
                                    BackgroundColor="#1C1C1E" TextColor="#A1A1AA" CornerRadius="18" HeightRequest="36" Padding="14, 0" />
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- source target -->
                    <Border Stroke="#27272A" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#141416" Padding="14, 10">
                        <Grid ColumnDefinitions="Auto, *">
                            <Picker x:Name="pickerFrom"
                                    Grid.Column="0"
                                    MaximumWidthRequest="140"
                                    TextColor="#A1A1AA"
                                    FontSize="15"
                                    SelectedIndexChanged="OnUnitChanged" />
                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                <Label x:Name="lblFromVal" Text="1" FontSize="32" FontAttributes="Bold" TextColor="#FFFFFF" VerticalTextAlignment="Center" />
                                <Label x:Name="lblConverterCursor" Text="|" FontSize="32" TextColor="#512BD4" FontAttributes="Bold" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- swap button -->
                    <Button Text="⇅ Swap" Clicked="OnSwapUnitsClicked"
                            BackgroundColor="Transparent" TextColor="#6D3EE4" FontSize="13" HorizontalOptions="Center" HeightRequest="28" Padding="0" />

                    <!-- target card -->
                    <Border Stroke="#512BD4" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" BackgroundColor="#18181B" Padding="14, 10">
                        <Grid ColumnDefinitions="Auto, *">
                            <Picker x:Name="pickerTo"
                                    Grid.Column="0"
                                    MaximumWidthRequest="140"
                                    TextColor="#A1A1AA"
                                    FontSize="15"
                                    SelectedIndexChanged="OnUnitChanged" />
                            <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalOptions="End" VerticalOptions="Center" HorizontalScrollBarVisibility="Never">
                                <Label x:Name="lblToVal" Text="1000" FontSize="32" FontAttributes="Bold" TextColor="#FAFAFA" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                            </ScrollView>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- right side -->
            <Grid x:Name="converterKeypad"
                  RowSpacing="6"
                  ColumnSpacing="8"
                  VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Text="7" Grid.Row="0" Grid.Column="0" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="8" Grid.Row="0" Grid.Column="1" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="9" Grid.Row="0" Grid.Column="2" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="C" Grid.Row="0" Grid.Column="3" Clicked="OnKeypadClear" BackgroundColor="#27272A" TextColor="#FAFAFA" CornerRadius="12" FontSize="17" FontAttributes="Bold" />

                <Button Text="4" Grid.Row="1" Grid.Column="0" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="5" Grid.Row="1" Grid.Column="1" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="6" Grid.Row="1" Grid.Column="2" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="⌫" Grid.Row="1" Grid.Column="3" Clicked="OnKeypadBackspace" BackgroundColor="#27272A" TextColor="#FAFAFA" CornerRadius="12" FontSize="17" FontAttributes="Bold" />

                <Button Text="1" Grid.Row="2" Grid.Column="0" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="2" Grid.Row="2" Grid.Column="1" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="3" Grid.Row="2" Grid.Column="2" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button x:Name="btnNegate" Text="±" Grid.Row="2" Grid.Column="3" Clicked="OnKeypadNegate" BackgroundColor="#27272A" TextColor="#FAFAFA" CornerRadius="12" FontSize="17" />

                <Button Text="0" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Clicked="OnKeypadDigit" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="." Grid.Row="3" Grid.Column="2" Clicked="OnKeypadDecimal" BackgroundColor="#18181B" TextColor="#FAFAFA" CornerRadius="12" FontSize="18" />
                <Button Text="OK" Grid.Row="3" Grid.Column="3" Clicked="OnKeypadOk" BackgroundColor="#512BD4" TextColor="#FFFFFF" CornerRadius="12" FontSize="17" FontAttributes="Bold" />
            </Grid>
        </Grid>

        <!-- modal overlay -->
        <Grid x:Name="modalOverlay"
              IsVisible="False"
              BackgroundColor="#AA000000">
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Stroke="#27272A"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#18181B"
                    Padding="22">
                <VerticalStackLayout Spacing="16">
                    <Label x:Name="lblModalTitle"
                           Text="Invalid Operation"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#FAFAFA" />
                    <Label x:Name="lblModalMessage"
                           Text="Length and distance measurements cannot be negative."
                           FontSize="15"
                           TextColor="#A1A1AA"
                           LineBreakMode="WordWrap" />
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="End" Margin="0, 8, 0, 0">
                        <Button Text="Understood"
                                Clicked="OnCloseModalClicked"
                                BackgroundColor="#512BD4"
                                TextColor="#FFFFFF"
                                CornerRadius="12"
                                FontSize="15"
                                FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>