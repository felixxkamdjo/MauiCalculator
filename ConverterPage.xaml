<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiCalculator.ConverterPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">

    <Grid RowDefinitions="Auto, *" Padding="20, 16, 20, 20" RowSpacing="20">
        
        <!-- En-tête avec onglets de retour -->
        <HorizontalStackLayout Grid.Row="0" Spacing="24" Margin="0, 10, 0, 0">
            <Label Text="Calculator"
                   FontSize="20"
                   TextColor="#71717A"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCalculatorTabTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Converter"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF" />
        </HorizontalStackLayout>

        <!-- Corps du convertisseur -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="24">

                <!-- Sélecteur de type d'unité -->
                <Border Stroke="#27272A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#18181B"
                        Padding="14, 4">
                    <Picker x:Name="pickerCategory"
                            TextColor="#FAFAFA"
                            Title="Sélectionnez une catégorie"
                            TitleColor="#71717A"
                            SelectedIndexChanged="OnCategoryChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Longueur (m ⇄ km ⇄ cm)</x:String>
                                <x:String>Masse (kg ⇄ g ⇄ lb)</x:String>
                                <x:String>Température (°C ⇄ °F)</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>

                <!-- Bloc d'entrée (Source) -->
                <Border Stroke="#27272A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#18181B"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Picker x:Name="pickerFromUnit"
                                TextColor="#A1A1AA"
                                SelectedIndexChanged="OnInputValuesChanged" />
                        <Entry x:Name="txtFromValue"
                               Text="1"
                               Keyboard="Numeric"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               BackgroundColor="Transparent"
                               HorizontalTextAlignment="End"
                               TextChanged="OnInputValuesChanged" />
                    </VerticalStackLayout>
                </Border>

                <!-- Icône d'inversion -->
                <Label Text="⇅"
                       FontSize="26"
                       TextColor="#512BD4"
                       HorizontalOptions="Center" />

                <!-- Bloc de sortie (Cible) -->
                <Border Stroke="#27272A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#18181B"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Picker x:Name="pickerToUnit"
                                TextColor="#A1A1AA"
                                SelectedIndexChanged="OnInputValuesChanged" />
                        <Label x:Name="lblToResult"
                               Text="0"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#512BD4"
                               HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>